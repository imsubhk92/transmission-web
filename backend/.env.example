TRANSMISSION_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_USERNAME=streamline
TRANSMISSION_PASSWORD=local-development-only
# Must match the daemon's absolute download directory, including across Docker mounts.
DOWNLOAD_DIR=../data/downloads
FRONTEND_DIR=../frontend/dist
APP_PASSWORD=
SESSION_SECRET=
SECURE_COOKIES=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
POLL_INTERVAL=2
STREAM_WAIT_SECONDS=30
