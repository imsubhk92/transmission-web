# Docker Compose reads this file from the repository root.
# Local FastAPI reads backend/.env; see backend/.env.example.
TRANSMISSION_USERNAME=streamline
TRANSMISSION_PASSWORD=local-development-only
TZ=Asia/Kolkata

# Optional workspace login. Keep the published port on loopback unless you configure access.
APP_PASSWORD=
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=
# Enable when serving through an HTTPS reverse proxy.
SECURE_COOKIES=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
